					"description": "Creates an explicit mapping for each drifted column"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
				"          {On Call} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Start Time} as timestamp,",
				"          {Exam End Time} as timestamp,",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          {Booked Date Time} as timestamp,",
				"          {Creation Date} as date,",
				"          {Exam Attended} as string,",
				"          {Exam Urgency} as string,",
				"          Modality as string,",
				"          {Number of Processes} as integer,",
				"          {Planned Appointment Date} as date,",
				"          {Datetime First Verified} as timestamp,",
				"          {Was Planned} as string,",
				"          {Was Scheduled} as string,",
				"          {Was Waiting} as string,",
				"          {Requested Datetime} as timestamp,",
				"          {Patient Type ID} as long,",
				"          {Modality ID} as integer,",
				"          {Status ID} as integer,",
				"          {Exam ID} as integer,",
				"          {Exam Room ID} as long,",
				"          {Trust ID} as integer,",
				"          {Referral Source ID} as integer,",
				"          {Tat Type ID} as integer,",
				"          {Reported By} as string,",
				"          Rank as integer,",
				"          Activity as integer,",
				"          {ActivIty 1} as long,",
				"          {Data Pull Date} as timestamp,",
				"          {Age At Event} as string,",
				"          {Event Date Time} as timestamp,",
				"          {Request-Image Days} as double,",
				"          {Image-Report Days} as double,",
				"          {Request-Report Days} as double,",
				"          {Request-Image Hours} as double,",
				"          {Image-Report Hours} as double,",
				"          {Request-Report Hours} as double,",
				"          {Image-Report 3H Pass} as integer,",
				"          {Image-Report 4H Pass} as integer,",
				"          {Image-Report 12H Pass} as integer,",
				"          {Image-Report 24H Pass} as integer,",
				"          {Image-Report 3D Pass} as integer,",
				"          {Image-Report 7D Pass} as integer,",
				"          {Image-Report 28D Pass} as integer,",
				"          UpOrIn as string,",
				"          {Updated Modality} as integer,",
				"          {Body Parts Activity} as integer,",
				"          {Request Year Only} as integer,",
				"          {Request Month Number Only} as integer,",
				"          {Report Year Only} as integer,",
				"          {Report Month Number Only} as integer,",
				"          {Month First Verified} as date,",
				"          {Event Year Only} as integer,",
				"          {Event Month Number Only} as integer,",
				"          {Event Hour} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'Stat Date',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     mode: 'read') ~> Core",
				"source(output(",
				"          {Status Code} as string,",
				"          {Status ID} as integer,",
				"          {Status Category} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          Year as string,",
				"          Local_Identifier as string,",
				"          Location as string,",
				"          Equipment_Detail as string,",
				"          Day as string,",
				"          {Hours Open} as string,",
				"          {Trust ID} as string,",
				"          {Modality ID} as integer,",
				"          ID2 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source(output(",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          Accession as string,",
				"          Referrer as string,",
				"          {Referral Location} as string,",
				"          {Referral Source} as string,",
				"          Urg as string,",
				"          Site as string,",
				"          {Status Code} as string,",
				"          {Status Date} as timestamp,",
				"          {Status Time} as integer,",
				"          {Referral Location Name} as string,",
				"          {Referral Source Name} as string,",
				"          {Referral Name} as string,",
				"          {Examination Name} as string,",
				"          Modality as string,",
				"          {Status Code at State Date} as string,",
				"          {Stat Date} as timestamp,",
				"          {D Status} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          {Exam Code} as string,",
				"          {Exam Name} as string,",
				"          {Stat Date} as timestamp,",
				"          {Exam ID} as integer,",
				"          {Exam Group} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source(output(",
				"          {Exam Site} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Room ID} as long,",
				"          Description as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"MapDrifted2 derive(DNA = iif({Status Code}==\"CPDNA\", 1, iif({Status Code}==\"APDNA\", 1, 0)),",
				"          {Trust ID 2} = case(isInteger(Description)==true(),Trust_ID_2,Trust_ID),",
				"          {Activity (ATP)} = iif({Status Code}==\"ATP\", 1,  0)) ~> CreateDNAColumn",
				"CreateDNAColumn aggregate(groupBy({Event Date} = toDate({Event Date Time}),",
				"          {Modality ID},",
				"          {Trust ID 2},",
				"          {Patient Type ID},",
				"          {Exam Group}),",
				"     Activity = sum({Activity (ATP)}),",
				"          DNA = sum(DNA)) ~> GroupbyEvent",
				"CreateDNAColumn aggregate(groupBy({Request Date} = toDate({Requested Datetime}),",
				"          {Modality ID},",
				"          {Trust ID 2},",
				"          {Patient Type ID},",
				"          {Exam Group}),",
				"     Demand = count(Activity)) ~> GroupbyRequest",
				"GroupbyRequest select(mapColumn(",
				"          Date = {Request Date},",
				"          {Modality ID},",
				"          {Trust ID} = {Trust ID 2},",
				"          Demand,",
				"          {Patient Type ID},",
				"          {Exam Group}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameDate1",
				"GroupbyEvent select(mapColumn(",
				"          Date = {Event Date},",
				"          {Modality ID},",
				"          {Trust ID} = {Trust ID 2},",
				"          Activity,",
				"          DNA,",
				"          {Patient Type ID},",
				"          {Exam Group}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameDate2",
				"RenameDate1 derive(Date = toDate(toString(Date)),",
				"          ID = concat(left(toString(Date),10)\r",
				", concat(toString({Modality ID})\r",
				", concat(toString(iif(isNull({Trust ID}),'NULL',{Trust ID}))\r",
				", concat(toString({Patient Type ID}),toString(iif(isNull({Exam Group}),'NULL',{Exam Group})))\r",
				")\r",
				")\r",
				")) ~> derivedColumn1",
				"RenameDate2 derive(Date = toDate(toString(Date)),",
				"          ID = concat(left(toString(Date),10), concat(toString({Modality ID}), concat(toString(iif(isNull({Trust ID}),'NULL',{Trust ID})), concat(toString({Patient Type ID}),toString(iif(isNull({Exam Group}),'NULL',{Exam Group}))))))) ~> derivedColumn2",
				"filter2, filter4 join(derivedColumn1@ID == derivedColumn2@ID,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(Date = iifNull(derivedColumn1@Date,derivedColumn2@Date),",
				"          {Modality ID} = iifNull(RenameDate1@{Modality ID},RenameDate2@{Modality ID}),",
				"          {Trust ID} = iifNull(RenameDate1@{Trust ID},RenameDate2@{Trust ID}),",
				"          ID = iifNull(derivedColumn1@ID, derivedColumn2@ID),",
				"          {Patient Type ID} = iifNull(RenameDate1@{Patient Type ID}, RenameDate2@{Patient Type ID}),",
				"          {Exam Group} = iifNull(RenameDate1@{Exam Group}, RenameDate2@{Exam Group})) ~> derivedColumn3",
				"derivedColumn4 select(mapColumn(",
				"          Date,",
				"          {Modality ID},",
				"          {Trust ID},",
				"          {Patient Type ID},",
				"          {Exam Group},",
				"          Demand,",
				"          ID,",
				"          Activity,",
				"          {Activity - Status},",
				"          DNA,",
				"          {DNA - Status},",
				"          Month,",
				"          {Day Name}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select7 derive(Month = addMonths(addDays(lastDayOfMonth(Date),1),-1),",
				"          {Day Name} = dayOfWeek(Date)) ~> derivedColumn4",
				"derivedColumn4 aggregate(groupBy({Modality ID},",
				"          {Trust ID},",
				"          {Patient Type ID},",
				"          {Exam Group},",
				"          Month),",
				"     {Monthly Activity Sum} = sum(Activity),",
				"          {Monthly Demand Sum} = sum(Demand),",
				"          {Monthly DNA Sum} = sum(DNA),",
				"          {Monthly Activity - Status Sum} = sum({Activity - Status}),",
				"          {Monthly DNA - Status Sum} = sum({DNA - Status})) ~> aggregate1",
				"aggregate1 aggregate(groupBy({Modality ID},",
				"          {Trust ID},",
				"          {Patient Type ID},",
				"          {Exam Group},",
				"          Month),",
				"     {Monthly Demand Max} = iif(isNull(max({Monthly Activity Sum})), max({Monthly Demand Sum}), iif(isNull(max({Monthly Demand Sum})), max({Monthly Activity Sum}), iif(max({Monthly Demand Sum})>max({Monthly Activity Sum}), max({Monthly Demand Sum}), max({Monthly Activity Sum}))))) ~> aggregate2",
				"aggregate2, aggregate1 join(aggregate2@{Modality ID} == aggregate1@{Modality ID}",
				"     && aggregate2@{Trust ID} == aggregate1@{Trust ID}",
				"     && aggregate2@Month == aggregate1@Month",
				"     && aggregate2@{Patient Type ID} == aggregate1@{Patient Type ID}",
				"     && aggregate2@{Exam Group} == aggregate1@{Exam Group},",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"select1, select2 join(select1@{Modality ID} == select2@{Modality ID}",
				"     && select1@{Trust ID} == select2@{Trust ID}",
				"     && select1@{Patient Type ID} == select2@{Patient Type ID}",
				"     && select1@{Exam Group} == select2@{Exam Group}",
				"     && select1@Month == select2@Month,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join2 select(mapColumn(",
				"          {Modality ID} = aggregate2@{Modality ID},",
				"          {Trust ID} = aggregate2@{Trust ID},",
				"          {Patient Type ID} = aggregate2@{Patient Type ID},",
				"          {Exam Group} = aggregate2@{Exam Group},",
				"          Month = aggregate2@Month,",
				"          {Monthly Demand Max},",
				"          {Monthly Activity Sum},",
				"          {Monthly Demand Sum},",
				"          {Monthly DNA Sum},",
				"          {Monthly Activity - Status Sum},",
				"          {Monthly DNA - Status Sum}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"lookup1 select(mapColumn(",
				"          Date,",
				"          {Modality ID} = select1@{Modality ID},",
				"          {Trust ID} = select1@{Trust ID},",
				"          {Patient Type ID} = select1@{Patient Type ID},",
				"          {Exam Group} = select1@{Exam Group},",
				"          Demand,",
				"          ID,",
				"          Activity,",
				"          {Activity - Status},",
				"          DNA,",
				"          {DNA - Status},",
				"          Month = select1@Month,",
				"          {Monthly Demand Max},",
				"          {Monthly Activity Sum},",
				"          {Monthly Activity - Status Sum},",
				"          {Monthly Demand Sum},",
				"          {Monthly DNA Sum},",
				"          {Monthly DNA - Status Sum},",
				"          {Hours Open},",
				"          Year = derivedColumn5@Year,",
				"          DNARate,",
				"          {DNARate - Status},",
				"          {Monthly DNARate},",
				"          {Monthly DNARate - Status},",
				"          ID2 = derivedColumn6@ID2,",
				"          {Day Name}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn7 filter(isNull(ID)==false()) ~> filter1",
				"derivedColumn1 filter(isNull(ID)==false()) ~> filter2",
				"derivedColumn2 filter(isNull(ID)==false()) ~> filter4",
				"Core, source1 join(Core@{Status ID} == source1@{Status ID},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join3 derive({Day Name} = iif({Day Name}==1, 'Sunday', iif({Day Name}==2, 'Monday', iif({Day Name}==3, 'Tuesday', iif({Day Name}==4, 'Wednesday', iif({Day Name}==5, 'Thursday', iif({Day Name}==6, 'Friday', iif({Day Name}==7, 'Saturday', '0'))))))),",
				"          Year = year(Date),",
				"          DNARate = DNA/(Activity+DNA),",
				"          {DNARate - Status} = {DNA - Status}/({Activity - Status}+{DNA - Status}),",
				"          {Monthly DNARate} = {Monthly DNA Sum}/({Monthly Activity Sum}+{Monthly DNA Sum}),",
				"          {Monthly DNARate - Status} = {Monthly DNA - Status Sum}/({Monthly Activity - Status Sum}+{Monthly DNA - Status Sum})) ~> derivedColumn5",
				"derivedColumn5 derive(ID2 = concat(toString(Year),':',{Day Name},':',toString(select1@{Trust ID}),':',toString(select1@{Modality ID}))) ~> derivedColumn6",
				"derivedColumn6, source2 lookup(derivedColumn6@ID2 == source2@ID2,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"select3 derive(SUR = Activity/toLong({Hours Open})) ~> derivedColumn7",
				"filter1 window(over({Modality ID},",
				"          {Trust ID},",
				"          Date),",
				"     asc(Date, true),",
				"     {Daily DNA Count} = sum(DNA),",
				"          {Daily Activity Count} = sum(Activity)) ~> window1",
				"window3 derive({Date (Month)} = iif(month(Date)==1,'Jan',iif(month(Date)==2,'Feb',iif(month(Date)==3,'Mar',iif(month(Date)==4,'Apr',iif(month(Date)==5,'May',iif(month(Date)==6,'Jun',iif(month(Date)==7,'Jul',iif(month(Date)==8,'Aug',iif(month(Date)==9,'Sep',iif(month(Date)==10,'Oct',iif(month(Date)==11,'Nov',iif(month(Date)==12,'Dec','ERROR')))))))))))),",
				"          {Date (Year)} = year(Date),",
				"          Capacity = toLong({Hours Open})*{Yearly SUR}) ~> derivedColumn9",
				"window1 window(over({Modality ID},",
				"          {Trust ID},",
				"          Month),",
				"     asc(Date, true),",
				"     {Monthly Activity Count} = sum(Activity),",
				"          {Monthly SUR} = avg(SUR)) ~> window2",
				"window2 window(over(Year,",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     asc(Date, true),",
				"     {Yearly SUR} = avg({Monthly SUR})) ~> window3",
				"derivedColumn9 window(over(Month,",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     asc(Date, true),",
				"     {Monthly Cap} = sum(Capacity)) ~> window4",
				"window4 select(mapColumn(",
				"          {Trust ID},",
				"          {Modality ID},",
				"          {Patient Type ID},",
				"          {Exam Group},",
				"          ID,",
				"          ID2,",
				"          {Yearly SUR},",
				"          {Date (Year)},",
				"          {Date (Month)},",
				"          {Monthly Demand Max},",
				"          {Monthly Demand Sum},",
				"          {Monthly Cap},",
				"          {Monthly Activity Sum},",
				"          {Monthly Activity - Status Sum},",
				"          {Monthly DNA Sum},",
				"          {Monthly DNA - Status Sum},",
				"          {Monthly DNARate},",
				"          {Monthly DNARate - Status},",
				"          {Monthly SUR},",
				"          {Day Name},",
				"          Date,",
				"          Demand,",
				"          Capacity,",
				"          Activity,",
				"          {Activity - Status},",
				"          DNA,",
				"          {DNA - Status},",
				"          DNARate,",
				"          {DNARate - Status},",
				"          {Hours Open},",
				"          SUR",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"source3 select(mapColumn(",
				"          {Exam Key},",
				"          {Status Code}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select5",
				"filter5, Core join(select5@{Exam Key} == Core@{Exam Key},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join5",
				"join8 select(mapColumn(",
				"          {Exam Key} = select5@{Exam Key},",
				"          {Event Date Time},",
				"          Modality = {Updated Modality},",
				"          {Trust ID},",
				"          {Status Code},",
				"          {Patient Type ID},",
				"          {Exam Group}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select6",
				"derivedColumn10 aggregate(groupBy({Exam Key},",
				"          {Event Date Time},",
				"          Modality,",
				"          {Trust ID},",
				"          {Patient Type ID},",
				"          {Exam Group}),",
				"     List = collect({Status Code})) ~> aggregate3",
				"select6 derive({Event Date Time} = toDate(toString({Event Date Time}))) ~> derivedColumn10",
				"select5 filter(in(['ATP','CPDNA'],{Status Code})) ~> filter5",
				"aggregate3 aggregate(groupBy({Event Date Time},",
				"          Modality,",
				"          {Trust ID},",
				"          {Patient Type ID},",
				"          {Exam Group}),",
				"     Activity = sum(iif(contains(List,#item=='ATP')==true(),1,0)),",
				"          DNA = sum(iif(contains(List,#item=='CPDNA')==true(),1,0))) ~> aggregate4",
				"derivedColumn3, aggregate4 join(toInteger(derivedColumn3@{Trust ID}) == aggregate4@{Trust ID}",
				"     && {Modality ID} == Modality",
				"     && Date == {Event Date Time}",
				"     && derivedColumn3@{Patient Type ID} == aggregate4@{Patient Type ID}",
				"     && derivedColumn3@{Exam Group} == aggregate4@{Exam Group},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join6",
				"join6 select(mapColumn(",
				"          Date,",
				"          {Modality ID},",
				"          {Trust ID} = derivedColumn3@{Trust ID},",
				"          {Patient Type ID} = derivedColumn3@{Patient Type ID},",
				"          {Exam Group} = derivedColumn3@{Exam Group},",
				"          ID,",
				"          Demand,",
				"          Activity = RenameDate2@Activity,",
				"          DNA = RenameDate2@DNA,",
				"          {Activity - Status} = aggregate4@Activity,",
				"          {DNA - Status} = aggregate4@DNA",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"join4, source4 join(Core@{Exam ID} == source4@{Exam ID},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join7",
				"join5, source4 join(Core@{Exam ID} == source4@{Exam ID},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join8",
				"join7, MapDrifted1 join(Core@{Exam Room ID} == source5@{Exam Room ID},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join9",
				"source5 derive(Postcode = toString(byName('Postcode')),",
				"          CDC = toString(byName('CDC')),",
				"          Modality_ID = toString(byName('Modality_ID')),",
				"          Trust_ID = toString(byName('Trust_ID')),",
				"          Trust_ID_2 = toString(byName('Trust_ID_2'))) ~> MapDrifted1",
				"join9 derive({Date First Verified} = toDate(byName('Date First Verified')),",
				"          {Event Date} = toDate(byName('Event Date')),",
				"          {Request Date} = toDate(byName('Request Date')),",
				"          Postcode = toString(byName('Postcode')),",
				"          CDC = toString(byName('CDC')),",
				"          Modality_ID = toString(byName('Modality_ID')),",
				"          Trust_ID = toString(byName('Trust_ID')),",
				"          Trust_ID_2 = toString(byName('Trust_ID_2'))) ~> MapDrifted2",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {Trust ID},",
				"          {Modality ID},",
				"          {Patient Type ID},",
				"          {Exam Group},",
				"          ID,",
				"          ID2,",
				"          {Yearly SUR},",
				"          {Date (Year)},",
				"          {Date (Month)},",
				"          {Monthly Demand Max},",
				"          {Monthly Demand Sum},",
				"          {Monthly Cap},",
				"          {Monthly Activity Sum},",
				"          {Monthly Activity - Status Sum},",
				"          {Monthly DNA Sum},",
				"          {Monthly DNA - Status Sum},",
				"          {Monthly DNARate},",
				"          {Monthly DNARate - Status},",
				"          {Monthly SUR},",
				"          {Day Name},",
				"          Date,",
				"          Demand,",
				"          Capacity,",
				"          Activity,",
				"          {Activity - Status},",
				"          DNA,",
				"          {DNA - Status},",
				"          DNARate,",
				"          {DNARate - Status},",
				"          {Hours Open},",
				"          SUR",
				"     )) ~> sink1"
			]
		}
	}
