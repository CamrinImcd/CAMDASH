{
	"name": "CreateActDem",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "FYF_ODBC_CORE_v2",
						"type": "DatasetReference"
					},
					"name": "Core"
				},
				{
					"dataset": {
						"referenceName": "Status",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable9",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Act_Dem",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "CreateDNAColumn"
				},
				{
					"name": "GroupbyEvent"
				},
				{
					"name": "GroupbyRequest"
				},
				{
					"name": "RenameDate1"
				},
				{
					"name": "RenameDate2"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "filter1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "filter4"
				},
				{
					"name": "join4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "derivedColumn7"
				},
				{
					"name": "window1"
				},
				{
					"name": "derivedColumn9"
				},
				{
					"name": "window2"
				},
				{
					"name": "window3"
				},
				{
					"name": "window4"
				},
				{
					"name": "select4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
				"          {On Call} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Start Time} as timestamp,",
				"          {Exam End Time} as timestamp,",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          {Booked Date Time} as timestamp,",
				"          {Creation Date} as date,",
				"          {Exam Attended} as string,",
				"          {Exam Urgency} as string,",
				"          Modality as string,",
				"          {Number of Processes} as integer,",
				"          {Planned Appointment Date} as date,",
				"          {Datetime First Verified} as timestamp,",
				"          {Was Planned} as string,",
				"          {Was Scheduled} as string,",
				"          {Was Waiting} as string,",
				"          {Requested Datetime} as timestamp,",
				"          {Patient Type ID} as long,",
				"          {Modality ID} as integer,",
				"          {Status ID} as integer,",
				"          {Exam ID} as integer,",
				"          {Exam Room ID} as long,",
				"          {Trust ID} as integer,",
				"          {Referral Source ID} as integer,",
				"          {Tat Type ID} as integer,",
				"          {Reported By} as string,",
				"          Rank as integer,",
				"          Activity as integer,",
				"          {ActivIty 1} as long,",
				"          {Data Pull Date} as timestamp,",
				"          {Age At Event} as string,",
				"          {Event Date Time} as timestamp,",
				"          {Request-Image Days} as double,",
				"          {Image-Report Days} as double,",
				"          {Request-Report Days} as double,",
				"          {Request-Image Hours} as double,",
				"          {Image-Report Hours} as double,",
				"          {Request-Report Hours} as double,",
				"          {Image-Report 3H Pass} as integer,",
				"          {Image-Report 4H Pass} as integer,",
				"          {Image-Report 12H Pass} as integer,",
				"          {Image-Report 24H Pass} as integer,",
				"          {Image-Report 3D Pass} as integer,",
				"          {Image-Report 7D Pass} as integer,",
				"          {Image-Report 28D Pass} as integer,",
				"          UpOrIn as string,",
				"          {Updated Modality} as integer,",
				"          {Body Parts Activity} as integer,",
				"          {Request Year Only} as integer,",
				"          {Request Month Number Only} as integer,",
				"          {Report Year Only} as integer,",
				"          {Report Month Number Only} as integer,",
				"          {Month First Verified} as date,",
				"          {Event Year Only} as integer,",
				"          {Event Month Number Only} as integer,",
				"          {Event Hour} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'Stat Date',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     mode: 'read') ~> Core",
				"source(output(",
				"          {Status Code} as string,",
				"          {Status ID} as integer,",
				"          {Status Category} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          Year as string,",
				"          Local_Identifier as string,",
				"          Location as string,",
				"          Equipment_Detail as string,",
				"          Day as string,",
				"          {Hours Open} as string,",
				"          {Trust ID} as string,",
				"          {Modality ID} as integer,",
				"          ID2 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"join4 derive(DNA = iif({Status Code}==\"CPDNA\", 1, iif({Status Code}==\"APDNA\", 1, 0))) ~> CreateDNAColumn",
				"CreateDNAColumn aggregate(groupBy({Event Date} = toDate({Event Date Time}),",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     Activity = sum(Activity),",
				"          DNA = sum(DNA)) ~> GroupbyEvent",
				"CreateDNAColumn aggregate(groupBy({Request Date} = toDate({Requested Datetime}),",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     Demand = count(Activity)) ~> GroupbyRequest",
				"GroupbyRequest select(mapColumn(",
				"          Date = {Request Date},",
				"          {Modality ID},",
				"          {Trust ID},",
				"          Demand",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameDate1",
				"GroupbyEvent select(mapColumn(",
				"          Date = {Event Date},",
				"          {Modality ID},",
				"          {Trust ID},",
				"          Activity,",
				"          DNA",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameDate2",
				"RenameDate1 derive(Date = toDate(toString(Date)),",
				"          ID = concat(left(toString(Date),10), concat(toString({Modality ID}), toString({Trust ID})))) ~> derivedColumn1",
				"RenameDate2 derive(Date = toDate(toString(Date)),",
				"          ID = concat(left(toString(Date),10), concat(toString({Modality ID}), toString({Trust ID})))) ~> derivedColumn2",
				"filter2, filter4 join(derivedColumn1@ID == derivedColumn2@ID,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(Date = iifNull(derivedColumn1@Date,derivedColumn2@Date),",
				"          {Modality ID} = iifNull(RenameDate1@{Modality ID},RenameDate2@{Modality ID}),",
				"          {Trust ID} = iifNull(RenameDate1@{Trust ID},RenameDate2@{Trust ID}),",
				"          ID = iifNull(derivedColumn1@ID, derivedColumn2@ID)) ~> derivedColumn3",
				"derivedColumn4 select(mapColumn(",
				"          Date,",
				"          {Modality ID},",
				"          {Trust ID},",
				"          Demand,",
				"          ID,",
				"          Activity,",
				"          DNA,",
				"          Month,",
				"          {Day Name}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn3 derive(Month = addMonths(addDays(lastDayOfMonth(Date),1),-1),",
				"          {Day Name} = dayOfWeek(Date)) ~> derivedColumn4",
				"derivedColumn4 aggregate(groupBy({Modality ID},",
				"          {Trust ID},",
				"          Month),",
				"     {Monthly Activity Sum} = sum(Activity),",
				"          {Monthly Demand Sum} = sum(Demand),",
				"          {Monthly DNA Sum} = sum(DNA)) ~> aggregate1",
				"aggregate1 aggregate(groupBy({Modality ID},",
				"          {Trust ID},",
				"          Month),",
				"     {Monthly Demand Max} = iif(isNull(max({Monthly Activity Sum})), max({Monthly Demand Sum}), iif(isNull(max({Monthly Demand Sum})), max({Monthly Activity Sum}), iif(max({Monthly Demand Sum})>max({Monthly Activity Sum}), max({Monthly Demand Sum}), max({Monthly Activity Sum}))))) ~> aggregate2",
				"aggregate2, aggregate1 join(aggregate2@{Modality ID} == aggregate1@{Modality ID}",
				"     && aggregate2@{Trust ID} == aggregate1@{Trust ID}",
				"     && aggregate2@Month == aggregate1@Month,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"select1, select2 join(select1@{Modality ID} == select2@{Modality ID}",
				"     && select1@{Trust ID} == select2@{Trust ID}",
				"     && select1@Month == select2@Month,",
				"     joinType:'outer',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"join2 select(mapColumn(",
				"          {Modality ID} = aggregate2@{Modality ID},",
				"          {Trust ID} = aggregate2@{Trust ID},",
				"          Month = aggregate2@Month,",
				"          {Monthly Demand Max},",
				"          {Monthly Activity Sum},",
				"          {Monthly Demand Sum},",
				"          {Monthly DNA Sum}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"lookup1 select(mapColumn(",
				"          Date,",
				"          {Modality ID} = select1@{Modality ID},",
				"          {Trust ID} = select1@{Trust ID},",
				"          Demand,",
				"          ID,",
				"          Activity,",
				"          DNA,",
				"          Month = select1@Month,",
				"          {Monthly Demand Max},",
				"          {Monthly Activity Sum},",
				"          {Monthly Demand Sum},",
				"          {Monthly DNA Sum},",
				"          {Hours Open},",
				"          Year = derivedColumn5@Year,",
				"          DNARate,",
				"          {Monthly DNARate},",
				"          ID2 = derivedColumn6@ID2,",
				"          {Day Name}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn7 filter(isNull(ID)==false()) ~> filter1",
				"derivedColumn1 filter(isNull(ID)==false()) ~> filter2",
				"derivedColumn2 filter(isNull(ID)==false()) ~> filter4",
				"Core, source1 join(Core@{Status ID} == source1@{Status ID},",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join4",
				"join3 derive({Day Name} = iif({Day Name}==1, 'Sunday', iif({Day Name}==2, 'Monday', iif({Day Name}==3, 'Tuesday', iif({Day Name}==4, 'Wednesday', iif({Day Name}==5, 'Thursday', iif({Day Name}==6, 'Friday', iif({Day Name}==7, 'Saturday', '0'))))))),",
				"          Year = year(Date),",
				"          DNARate = DNA/(Activity+DNA),",
				"          {Monthly DNARate} = {Monthly DNA Sum}/({Monthly Activity Sum}+{Monthly DNA Sum})) ~> derivedColumn5",
				"derivedColumn5 derive(ID2 = concat(toString(year(Date)),':',{Day Name},':',toString(select1@{Trust ID}),':',toString(select1@{Modality ID}))) ~> derivedColumn6",
				"derivedColumn6, source2 lookup(derivedColumn6@ID2 == source2@ID2,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"select3 derive(SUR = Activity/toLong({Hours Open})) ~> derivedColumn7",
				"filter1 window(over({Modality ID},",
				"          {Trust ID},",
				"          Date),",
				"     asc(Date, true),",
				"     {Daily DNA Count} = sum(DNA),",
				"          {Daily Activity Count} = sum(Activity)) ~> window1",
				"window3 derive({Date (Month)} = iif(month(Date)==1,'Jan',iif(month(Date)==2,'Feb',iif(month(Date)==3,'Mar',iif(month(Date)==4,'Apr',iif(month(Date)==5,'May',iif(month(Date)==6,'Jun',iif(month(Date)==7,'Jul',iif(month(Date)==8,'Aug',iif(month(Date)==9,'Sep',iif(month(Date)==10,'Oct',iif(month(Date)==11,'Nov',iif(month(Date)==12,'Dec','ERROR')))))))))))),",
				"          {Date (Year)} = year(Date),",
				"          {DNA Daily} = {Daily DNA Count}/{Daily DNA Count}+{Daily Activity Count},",
				"          {DNA Monthly} = {Monthly DNA Count}/{Monthly DNA Count}+{Monthly Activity Count},",
				"          Capacity = toLong({Hours Open})*{Yearly SUR}) ~> derivedColumn9",
				"window1 window(over({Modality ID},",
				"          {Trust ID},",
				"          Month),",
				"     asc(Date, true),",
				"     {Monthly DNA Count} = sum(DNA),",
				"          {Monthly Activity Count} = sum(Activity),",
				"          {Monthly SUR} = avg(SUR)) ~> window2",
				"window2 window(over(Year,",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     asc(Date, true),",
				"     {Yearly SUR} = avg({Monthly SUR})) ~> window3",
				"derivedColumn9 window(over(Month,",
				"          {Modality ID},",
				"          {Trust ID}),",
				"     asc(Date, true),",
				"     {Monthly Cap} = sum(Capacity)) ~> window4",
				"window4 select(mapColumn(",
				"          {Trust ID},",
				"          {Modality ID},",
				"          ID,",
				"          ID2,",
				"          {Date (Year)},",
				"          {Yearly SUR},",
				"          {Date (Month)},",
				"          {Monthly Demand Max},",
				"          {Monthly Demand Sum},",
				"          {Monthly Cap},",
				"          {Monthly Activity Sum},",
				"          {Monthly DNA Sum},",
				"          {DNA Monthly Count} = {Monthly DNA Count},",
				"          {DNA Monthly},",
				"          {Monthly DNARate},",
				"          {Monthly SUR},",
				"          {Day Name},",
				"          Date,",
				"          Demand,",
				"          Capacity,",
				"          Activity,",
				"          DNA,",
				"          {DNA Daily},",
				"          DNARate,",
				"          {Hours Open},",
				"          SUR",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select4",
				"select4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}