				},
				{
					"name": "aggregate6"
				},
				{
					"name": "exists4"
				},
				{
					"name": "sort4"
				},
				{
					"name": "surrogateKey4"
				},
				{
					"name": "join4"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Site as string,",
				"          Room as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Site],[Room]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_PTL]\\n  Group by [Site],[Room]',",
				"     format: 'query') ~> AzureSqlPTL",
				"source(output(",
				"          {Ref Src} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'Stat Date',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT Distinct([Ref Src]) as [Ref Src]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\n  Group by [Ref Src]',",
				"     format: 'query') ~> RefSrc",
				"source(output(",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Examination], [Exam Name]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\n  Group by [Examination],[Exam Name]',",
				"     format: 'query') ~> Examination",
				"source(output(",
				"          {Status Code} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Status Code]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_STATUSES]\\n  Group by [Status Code]',",
				"     format: 'query') ~> STATUSES",
				"source(output(",
				"          Site as string,",
				"          Room as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Site],[Room]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\n  Group by [Site],[Room]',",
				"     format: 'query') ~> SiteRoom",
				"source(output(",
				"          {Referral Source} as string,",
				"          {Stat Date} as timestamp,",
				"          {Referral Source ID} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ReferralSourceRef",
				"source(output(",
				"          {Exam Name} as string,",
				"          {Exam Code} as string,",
				"          {Exam ID} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ExamRef",
				"source(output(",
				"          {Status Code} as string,",
				"          {Status ID} as integer,",
				"          {Status Category} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> StatusRef",
				"source(output(",
				"          {Exam Site} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Room ID} as long,",
				"          Description as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SiteRef",
				"SiteRoom select(mapColumn(",
				"          {Exam Site} = Site,",
				"          {Exam Room} = Room,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns6",
				"CombineCOREPTL6 derive({ExamSite Code} = iifNull({Exam Site},'NULL')+iifNull({Exam Room},'NULL')) ~> JointColumn6",
				"derivedColumn3 derive({Status Category} = iif(startsWith({Status Code}, \"AP\"), \"AP\", iif(startsWith({Status Code}, \"AS\"), \"AS\", iif(startsWith({Status Code}, \"AT\"), \"AT\", iif(startsWith({Status Code}, \"C\"), \"C\", iif(startsWith({Status Code}, \"D\"), \"D\", iif(startsWith({Status Code}, \"E\"), \"E\", iif(startsWith({Status Code}, \"P\"), \"P\", iif(startsWith({Status Code}, \"R\"), \"R\", iif(startsWith({Status Code}, \"V\"), \"V\", iif(startsWith({Status Code}, \"W\"), \"W\", iif({Status Code} == \"BHSRAI\", \"ST\", iif({Status Code} == \"ACNCLI\", \"W\", iif({Status Code} == \"SRREPC\", \"ST\", \"0\")))))))))))))) ~> DeriveColumn4",
				"derivedColumn2 select(mapColumn(",
				"          {Exam Code} = Examination,",
				"          {Exam Name},",
				"          {Stat Date},",
				"          {Exam ID}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns3",
				"derivedColumn1 select(mapColumn(",
				"          {Referral Source} = {Ref Src},",
				"          {Stat Date},",
				"          {Referral Source ID}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns1",
				"AzureSqlPTL select(mapColumn(",
				"          {Exam Site} = Site,",
				"          {Exam Room} = Room,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns9",
				"RenameColumns6, RenameColumns9 union(byName: true)~> CombineCOREPTL6",
				"derivedColumn4 select(mapColumn(",
				"          {Exam Site},",
				"          {Exam Room},",
				"          {ExamSite Code},",
				"          {Exam Room ID} = {ExamSite Code ID},",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"RefSrc, ReferralSourceRef exists({Ref Src} == {Referral Source},",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"ReferralSourceRef aggregate(MaxID = max({Referral Source ID})) ~> aggregate2",
				"sort1 keyGenerate(output(Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"join1 derive({Referral Source ID} = toInteger(Key+MaxID)) ~> derivedColumn1",
				"surrogateKey1, aggregate2 join(Key < MaxID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> join1",
				"exists1 sort(asc({Ref Src}, false)) ~> sort1",
				"ExamRef aggregate(MaxID = max({Exam ID})) ~> aggregate4",
				"Examination, ExamRef exists(Examination == {Exam Code},",
				"     negate:true,",
				"     broadcast: 'auto')~> exists2",
				"exists2 sort(asc(Examination, false)) ~> sort2",
				"sort2 keyGenerate(output(Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey2",
				"surrogateKey2, aggregate4 join(Key < MaxID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> join2",
				"join2 derive({Exam ID} = toInteger(Key+MaxID)) ~> derivedColumn2",
				"StatusRef aggregate(MaxID = max({Status ID})) ~> aggregate5",
				"STATUSES, StatusRef exists(STATUSES@{Status Code} == StatusRef@{Status Code},",
				"     negate:true,",
				"     broadcast: 'auto')~> exists3",
				"exists3 sort(asc({Status Code}, false)) ~> sort3",
				"sort3 keyGenerate(output(Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey3",
				"surrogateKey3, aggregate5 join(Key < MaxID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> join3",
				"join3 derive({Status ID} = toInteger(Key+MaxID)) ~> derivedColumn3",
				"SiteRef aggregate(MaxID = max({Exam Room ID})) ~> aggregate6",
				"JointColumn6, SiteRef exists(JointColumn6@{ExamSite Code} == SiteRef@{ExamSite Code},",
				"     negate:true,",
				"     broadcast: 'auto')~> exists4",
				"exists4 sort(asc({ExamSite Code}, true)) ~> sort4",
				"sort4 keyGenerate(output(Key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey4",
				"surrogateKey4, aggregate6 join(Key < MaxID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'right')~> join4",
				"join4 derive({ExamSite Code ID} = toInteger(Key+MaxID)) ~> derivedColumn4",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Exam Site} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Room ID} as long,",
				"          Description as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {Exam Site},",
				"          {Exam Room},",
				"          {ExamSite Code},",
				"          {Exam Room ID},",
				"          {Stat Date}",
				"     )) ~> SiteRoomOut",
				"DeriveColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Status Code} as string,",
				"          {Status ID} as integer,",
				"          {Status Category} as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> Status",
				"RenameColumns3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Exam Name} as string,",
				"          {Exam Code} as string,",
				"          {Exam ID} as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> Exam",
				"RenameColumns1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Referral Source} as string,",
				"          {Stat Date} as timestamp,",
				"          {Referral Source ID} as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {Referral Source},",
				"          {Stat Date},",
				"          {Referral Source ID}",
				"     )) ~> ReferralSource"
			]
		}
	}
}