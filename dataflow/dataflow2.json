			"scriptLines": [
				"source(output(",
				"          Site as string,",
				"          Room as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Site],[Room]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_PTL]\\n  Group by [Site],[Room]',",
				"     format: 'query') ~> AzureSqlPTL",
				"source(output(",
				"          Site as string,",
				"          Room as string,",
				"          {Room Desc} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          {Ref Src} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'Stat Date',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Ref Src] as [Ref Src]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\n  where [Ref Src] not in (SELECT [Referral Source]\\n  FROM [dev].[Referral Source])\\n  Group by [Ref Src]',",
				"     format: 'query') ~> RefSrc",
				"source(output(",
				"          Patient_Type as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: '  SELECT [Patient_Type]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE_v2]\\n   where [Patient_Type] not in (SELECT [Patient_Type]\\n    FROM [dev].[Patient Type])\\n  Group by [Patient_Type]',",
				"     format: 'query') ~> PatientTypeIn",
				"source(output(",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Examination], [Exam Name]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\nwhere [Examination] not in (SELECT [Examination]\\n    FROM [dev].[Exam])\\n  Group by [Examination],[Exam Name]\\n',",
				"     format: 'query') ~> Examination",
				"source(output(",
				"          {Status Code} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Status Code]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_STATUSES]\\nwhere [Status Code]not in (SELECT [Status Code]\\n    FROM [dev].[FYF_ODBC_STATUSES])\\n  Group by [Status Code]',",
				"     format: 'query') ~> STATUSES",
				"source(output(",
				"          Modality2 as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT Distinct([Modality2]) as [Modality2]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE_v2]\\nwhere [Modality2] not in (SELECT [Modality2]\\n    FROM [dev].[Modality])\\n  Group by [Modality2]',",
				"     format: 'query') ~> ModalityIN",
				"source(output(",
				"          Site as string,",
				"          Room as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Site],[Room]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE]\\n  Group by [Site],[Room]',",
				"     format: 'query') ~> SiteRoom",
				"source(output(",
				"          {Tat Type} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT [Tat Type]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE_v2]\\n  where [Tat Type] not in (SELECT [Tat Type] FROM [dev].[Tat Type])\\n  Group by [Tat Type]',",
				"     format: 'query') ~> TatTypeIn",
				"source(output(",
				"          {Trust Name} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT Distinct([Trust Name]) as [Trust Name]\\n      ,Min([Stat Date]) as [Stat Date]\\n  FROM [dev].[FYF_ODBC_CORE_v2]\\nwhere [Trust Name] not in (SELECT [Trust Name]\\n     FROM [dev].[Trust])\\n  Group by [Trust Name]',",
				"     format: 'query') ~> TrustIn",
				"source(output(",
				"          {Referral Source} as string,",
				"          {Stat Date} as timestamp,",
				"          {Referral Source ID} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ReferralSourceRef",
				"source(output(",
				"          Patient_Type as string,",
				"          Patient_Type_ID as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          {Exam Name} as string,",
				"          {Exam Code} as string,",
				"          {Exam ID} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source(output(",
				"          {Status Code} as string,",
				"          {Status ID} as integer,",
				"          {Status Category} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source5",
				"source(output(",
				"          Modality2 as string,",
				"          {Modality ID} as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source6",
				"source(output(",
				"          {Exam Site} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Room ID} as long,",
				"          Description as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source7",
				"source(output(",
				"          {Tat Type} as string,",
				"          {Tat Type ID} as integer,",
				"          Target as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source8",
				"source(output(",
				"          {Trust Name} as string,",
				"          {Trust ID} as integer,",
				"          {Trust Name Group} as string,",
				"          {Trust Name Group2} as string,",
				"          {Trust Name Group3} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source9",
				"TatTypeIn rank(asc({Tat Type}, true),",
				"     output({Tat Type ID} as long)) ~> RankColumns8",
				"RankColumns8 derive(Target = iif({Tat Type} == \"Urgent Inpatients\",\"12 hours\",iif({Tat Type} == \"Non-Urgent Inpatients\", \"24 hours\",iif({Tat Type} == \"Outpatient Faster Diagnosis Standard Cancer Pathway\", \"3 days\",iif({Tat Type} == \"Urgent GP and Outpatients\", \"7 days\",iif({Tat Type} == \"All Other Routine Outpatient and GP Studies\", \"28 days\",iif({Tat Type} == \"Acutely Unwell/ED Patients\", \"12 hours\",iif({Tat Type} == \"Other Inpatients\" , \"7 days\",iif({Tat Type} == \"Urgent GP/Urgent Outpatients\", \"7 days\",iif({Tat Type} == \"Routine GP and outpatients\", \"28 days\",iif({Tat Type} == \"Ultrasound and interventional Radiology\", \"3 hours\",\"0\"))))))))))) ~> DeriveColumn8",
				"TrustIn rank(asc({Trust Name}, true),",
				"     output({Trust ID} as long),",
				"     dense: true) ~> RankColumns7",
				"RankColumns7 derive({Trust Name Group} = iif( {Trust Name} == \"Womens\", \"REP\", iif( {Trust Name} == \"LUHFT\", \"REM\", iif( {Trust Name} == \"WUTH\", \"RBL\", iif( {Trust Name} == \"STHK\", \"RBN\", iif( {Trust Name} == \"S&O\", \"RVY\", iif( {Trust Name} == \"LHCH\", \"RBQ\", iif( {Trust Name} == \"Alder Hey\", \"RBS\", iif( {Trust Name} == \"MCH\", \"RBT\", iif( {Trust Name} == \"CCC\", \"REN\", iif( {Trust Name} == \"TWC\", \"RET\", iif( {Trust Name} == \"COCH\", \"RJR\", iif( {Trust Name} == \"WHH\", \"RWW\", iif( {Trust Name} == \"5M501\", \"REM\", iif( {Trust Name} == \"NTD05\", \"REM\", \"Other\")))))))))))))),",
				"          {Trust Name Group2} = iif( {Trust Name} == \"Womens\", \"Womens\", iif( {Trust Name} == \"LUHFT\", \"LUHFT\", iif( {Trust Name} == \"WUTH\", \"WUTH\", iif( {Trust Name} == \"STHK\", \"STHK\", iif( {Trust Name} == \"S&O\", \"S&O\", iif( {Trust Name} == \"LHCH\", \"LHCH\", iif( {Trust Name} == \"Alder Hey\", \"Alder Hey\", iif( {Trust Name} == \"MCH\", \"MCH\", iif( {Trust Name} == \"CCC\", \"CCC\", iif( {Trust Name} == \"TWC\", \"TWC\", iif( {Trust Name} == \"COCH\", \"COCH\", iif( {Trust Name} == \"WHH\", \"WHH\", iif( {Trust Name} == \"5M501\", \"LUHFT\", iif( {Trust Name} == \"NTD05\", \"LUHFT\", \"Other\")))))))))))))),",
				"          {Trust Name Group3} = iif( {Trust Name} == \"Womens\", \"REP\", iif( {Trust Name} == \"LUHFT\", \"REM\", iif( {Trust Name} == \"WUTH\", \"WUTH\", iif( {Trust Name} == \"STHK\", \"RBN\", iif( {Trust Name} == \"S&O\", \"RVY\", iif( {Trust Name} == \"LHCH\", \"RBQ\", iif( {Trust Name} == \"Alder Hey\", \"RBS\", iif( {Trust Name} == \"MCH\", \"RBT\", iif( {Trust Name} == \"CCC\", \"REN\", iif( {Trust Name} == \"TWC\", \"RET\", iif( {Trust Name} == \"COCH\", \"COCH\", iif( {Trust Name} == \"WHH\", \"RWW\", \"Other\"))))))))))))) ~> DeriveColumn7",
				"SiteRoom select(mapColumn(",
				"          {Exam Site} = Site,",
				"          {Exam Room} = Room,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns6",
				"CombineCOREPTL6 derive({ExamSite Code} = iifNull({Exam Site},'NULL')+iifNull({Exam Room},'NULL')) ~> JointColumn6",
				"aggregate1 rank(asc({ExamSite Code}, true),",
				"     output({Exam Room ID} as long)) ~> RankColumns6",
				"ModalityIN rank(asc(Modality2, true),",
				"     output({Modality ID} as long)) ~> RankColumns5",
				"STATUSES rank(asc({Status Code}, true),",
				"     output({Status ID} as long)) ~> RankColumns4",
				"RankColumns4 derive({Status Category} = iif(startsWith({Status Code}, \"AP\"), \"AP\", iif(startsWith({Status Code}, \"AS\"), \"AS\", iif(startsWith({Status Code}, \"AT\"), \"AT\", iif(startsWith({Status Code}, \"C\"), \"C\", iif(startsWith({Status Code}, \"D\"), \"D\", iif(startsWith({Status Code}, \"E\"), \"E\", iif(startsWith({Status Code}, \"P\"), \"P\", iif(startsWith({Status Code}, \"R\"), \"R\", iif(startsWith({Status Code}, \"V\"), \"V\", iif(startsWith({Status Code}, \"W\"), \"W\", iif({Status Code} == \"BHSRAI\", \"ST\", iif({Status Code} == \"ACNCLI\", \"W\", iif({Status Code} == \"SRREPC\", \"ST\", \"0\")))))))))))))) ~> DeriveColumn4",
				"Examination select(mapColumn(",
				"          {Exam Code} = Examination,",
				"          {Exam Name},",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns3",
				"RenameColumns3 rank(asc({Exam Code}, true),",
				"     output({Exam ID} as long)) ~> RankColumns3",
				"PatientTypeIn rank(asc(Patient_Type, true),",
				"     output({Patient Type ID} as long)) ~> RankColumns2",
				"RefSrc select(mapColumn(",
				"          {Referral Source} = {Ref Src},",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns1",
				"union1 rank(asc({Referral Source ID}, true),",
				"     asc({Referral Source}, true),",
				"     output({Referral Source ID} as long)) ~> RankColumns1",
				"AzureSqlPTL select(mapColumn(",
				"          {Exam Site} = Site,",
				"          {Exam Room} = Room,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns9",
				"RenameColumns6, RenameColumns9 union(byName: true)~> CombineCOREPTL6",
				"RankColumns6, source1 lookup({ExamSite Code} == concat(Site,Room),",
				"     multiple: true,",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 select(mapColumn(",
				"          {Exam Site},",
				"          {Exam Room},",
				"          {ExamSite Code},",
				"          {Exam Room ID},",
				"          Description = {Room Desc},",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"JointColumn6 aggregate(groupBy({ExamSite Code},",
				"          {Exam Site},",
				"          {Exam Room}),",
				"     {Stat Date} = min({Stat Date})) ~> aggregate1",
				"RenameColumns1, ReferralSourceRef union(byName: true)~> union1",
				"DeriveColumn8 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Tat Type} as string,",
				"          {Tat Type ID} as integer,",
				"          Target as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> TatType",
				"DeriveColumn7 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Trust Name} as string,",
				"          {Trust ID} as integer,",
				"          {Trust Name Group} as string,",
				"          {Trust Name Group2} as string,",
				"          {Trust Name Group3} as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> Trust",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {Exam Site} as string,",
				"          {Exam Room} as string,",
				"          {ExamSite Code} as string,",
				"          {Exam Room ID} as long,",
				"          Description as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     recreate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {Exam Site},",
				"          {Exam Room},",
				"          {ExamSite Code},",
				"          {Exam Room ID},",
				"          Description,",
				"          {Stat Date}",
				"     )) ~> SiteRoomOut",
				"RankColumns5 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Modality2 as string,",
				"          {Modality ID} as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
