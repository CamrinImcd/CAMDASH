{
	"name": "dataflow12",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "Patient_Type",
						"type": "DatasetReference"
					},
					"name": "source3"
				},
				{
					"dataset": {
						"referenceName": "Modality",
						"type": "DatasetReference"
					},
					"name": "source4"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSql_CORE",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "lookup2"
				},
				{
					"name": "select2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Unique  Identifier for patient} as string,",
				"          {Ref Src} as string,",
				"          {Referring Locat} as string,",
				"          Referrer as string,",
				"          Speciality as string,",
				"          GP as string,",
				"          Practice as string,",
				"          Site as string,",
				"          {Request Date} as string,",
				"          {Event Date/Time} as string,",
				"          PT as string,",
				"          RC as string,",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          Room as string,",
				"          {Exam Start Date/Time} as string,",
				"          {Exam End Date/Time} as string,",
				"          {Radiographer 1} as string,",
				"          {Radiographer 2} as string,",
				"          {Qty Used} as string,",
				"          {Exam Key} as string,",
				"          {Event Key} as string,",
				"          {Status Code} as string,",
				"          {Booked Date/Time} as string,",
				"          Attended as string,",
				"          {Lead Clinician} as string,",
				"          Urg as string,",
				"          {Referring Locat Name} as string,",
				"          {Referrer Name} as string,",
				"          Modality as string,",
				"          {No of Proc} as string,",
				"          {GP Name} as string,",
				"          {Date/Time First Verified} as string,",
				"          {Reported By} as string,",
				"          {Reported By2} as string,",
				"          {Reported By Name} as string,",
				"          {Reported By2 Name} as string,",
				"          {Time Taken} as string,",
				"          {Was Planned} as string,",
				"          {Was Waiting} as string,",
				"          CCG as string,",
				"          {Stat Date} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          Patient_Type as string,",
				"          {Stat Date} as timestamp,",
				"          {Patient Type ID} as long,",
				"          {Patient Type Code} as string,",
				"          {Cerner Patient Type} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source3",
				"source(output(",
				"          Modality2 as string,",
				"          {Stat Date} as timestamp,",
				"          {Modality ID} as integer,",
				"          Modality as string,",
				"          DIAGNOSTIC_TESTS as string,",
				"          {Cerner Modality} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source4",
				"source2 select(mapColumn(",
				"          Accession = {Unique  Identifier for patient},",
				"          {Ref Src},",
				"          {Referring Locat},",
				"          Referrer,",
				"          Speciality,",
				"          GP,",
				"          Practice,",
				"          Site,",
				"          {Request Date},",
				"          {Event Date} = {Event Date/Time},",
				"          {Event Time} = {Event Date/Time},",
				"          PT,",
				"          RC,",
				"          Examination,",
				"          {Exam Name},",
				"          Room,",
				"          {Start Time} = {Exam Start Date/Time},",
				"          {End Time} = {Exam End Date/Time},",
				"          {Radiographer 1},",
				"          {Radiographer 2},",
				"          {Qty Used},",
				"          {Exam Key},",
				"          {Event Key},",
				"          {Status Code},",
				"          {Booked Date} = {Booked Date/Time},",
				"          {Booked Time} = {Booked Date/Time},",
				"          Attended,",
				"          {Lead Clinician},",
				"          Urg,",
				"          {Referring Locat Name},",
				"          {Referrer Name},",
				"          Modality,",
				"          {No of Proc},",
				"          {GP Name},",
				"          {Date First Verified} = {Date/Time First Verified},",
				"          {Reported By},",
				"          {Reported By2},",
				"          {Reported By Name},",
				"          {Reported By2 Name},",
				"          {Time Taken},",
				"          {Was Planned},",
				"          {Was Waiting},",
				"          CCG,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive({Stat Date} = toTimestamp({Stat Date},'dd/MM/yyyy HH:mm'),",
				"          {Booked Date} = toTimestamp({Booked Date},'dd/MM/yyyy HH:mm'),",
				"          {Date First Verified} = toTimestamp({Date First Verified},'dd/MM/yyyy HH:mm'),",
				"          {Event Date} = toTimestamp({Event Date},'dd/MM/yyyy HH:mm'),",
				"          {Request Date} = toTimestamp({Request Date},'dd/MM/yyyy HH:mm'),",
				"          {Time Taken} = toLong({Time Taken}),",
				"          {No of Proc} = toLong({No of Proc}),",
				"          {Exam Key} = toLong({Exam Key}),",
				"          {Event Key} = toLong({Event Key}),",
				"          {Qty Used} = toDecimal({Qty Used}),",
				"          {Event Time} = concat(toString(hour(toTimestamp({Event Date},'dd/MM/yyyy HH:mm')),'00'),toString(minute(toTimestamp({Event Date},'dd/MM/yyyy HH:mm')),'00')),",
				"          {Start Time} = concat(toString(hour(toTimestamp({Start Time},'dd/MM/yyyy HH:mm')),'00'),toString(minute(toTimestamp({Start Time},'dd/MM/yyyy HH:mm')),'00')),",
				"          {End Time} = concat(toString(hour(toTimestamp({End Time},'dd/MM/yyyy HH:mm')),'00'),toString(minute(toTimestamp({End Time},'dd/MM/yyyy HH:mm')),'00')),",
				"          {Booked Time} = concat(toString(hour(toTimestamp({Booked Time},'dd/MM/yyyy HH:mm')),'00'),toString(minute(toTimestamp({Booked Time},'dd/MM/yyyy HH:mm')),'00'))) ~> derivedColumn1",
				"derivedColumn1, source3 lookup(PT == {Cerner Patient Type},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1, source4 lookup(select1@Modality == {Cerner Modality},",
				"     multiple: true,",
				"     broadcast: 'auto',",
				"     pickup: 'any')~> lookup2",
				"lookup2 select(mapColumn(",
				"          Accession,",
				"          {Ref Src},",
				"          {Referring Locat},",
				"          Referrer,",
				"          Speciality,",
				"          GP,",
				"          Practice,",
				"          Site,",
				"          {Request Date},",
				"          {Event Date},",
				"          {Event Time},",
				"          RC,",
				"          Examination,",
				"          {Exam Name},",
				"          Room,",
				"          {Start Time},",
				"          {End Time},",
				"          {Radiographer 1},",
				"          {Radiographer 2},",
				"          {Qty Used},",
				"          {Exam Key},",
				"          {Event Key},",
				"          {Status Code},",
				"          {Booked Date},",
				"          {Booked Time},",
				"          Attended,",
				"          {Lead Clinician},",
				"          Urg,",
				"          {Referring Locat Name},",
				"          {Referrer Name},",
				"          {No of Proc},",
				"          {GP Name},",
				"          {Date First Verified},",
				"          {Reported By},",
				"          {Reported By2},",
				"          {Reported By Name},",
				"          {Reported By2 Name},",
				"          {Time Taken},",
				"          {Was Planned},",
				"          {Was Waiting},",
				"          CCG,",
				"          {Stat Date} = derivedColumn1@{Stat Date},",
				"          Patient_Type,",
				"          Modality = source4@Modality",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
				"          {Ref Src} as string,",
				"          {Referring Locat} as string,",
				"          Referrer as string,",
				"          Speciality as string,",
				"          GP as string,",
				"          Practice as string,",
				"          {Postcode L} as string,",
				"          {Postcode R} as string,",
				"          Site as string,",
				"          {Request Date} as timestamp,",
				"          {Event Date} as timestamp,",
				"          {Event Time} as string,",
				"          {On Call} as string,",
				"          PT as string,",
				"          RC as string,",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          Room as string,",
				"          {Start Time} as string,",
				"          {End Time} as string,",
				"          {Radiographer 1} as string,",
				"          {Radiographer 2} as string,",
				"          {Required Clinician} as string,",
				"          {Contrast Code} as string,",
				"          {Qty Used} as decimal(6,2),",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          {Status Code} as string,",
				"          {Booked Date} as timestamp,",
				"          {Booked Time} as string,",
				"          {Creation Date} as timestamp,",
				"          Attended as string,",
				"          {Event Key2} as integer,",
				"          {Lead Clinician} as string,",
				"          {Intended Radiologist} as string,",
				"          Urg as string,",
				"          {Referring Locat Name } as string,",
				"          {Referrer Name} as string,",
				"          Modality as string,",
				"          {No of Proc} as integer,",
				"          {GP Name} as string,",
				"          {Planned Appointment Date} as timestamp,",
				"          {Date First Verified} as timestamp,",
				"          {Reported By} as string,",
				"          {Reported By2} as string,",
				"          {Reported By2 Name} as string,",
				"          {Reported By Name} as string,",
				"          {Time First Verified} as string,",
				"          {Time Taken} as integer,",
				"          {Typed By} as string,",
				"          {Was Planned} as string,",
				"          {Was Scheduled} as string,",
				"          {Was Waiting} as string,",
				"          CCG as string,",
				"          Postcode as string,",
				"          {Day of Week} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}