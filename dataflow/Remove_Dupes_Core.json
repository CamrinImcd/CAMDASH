{
	"name": "Remove_Dupes_Core",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSql_CORE",
						"type": "DatasetReference"
					},
					"name": "AzureSqlCORE"
				},
				{
					"dataset": {
						"referenceName": "AzureSql_Patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlCOREStageStep1",
						"type": "DatasetReference"
					},
					"name": "AzureSqlCOREStageStep1"
				}
			],
			"transformations": [
				{
					"name": "window1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "union1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
				"          {Ref Src} as string,",
				"          {Referring Locat} as string,",
				"          Referrer as string,",
				"          Speciality as string,",
				"          GP as string,",
				"          Practice as string,",
				"          {Postcode L} as string,",
				"          {Postcode R} as string,",
				"          Site as string,",
				"          {Request Date} as timestamp,",
				"          {Event Date} as timestamp,",
				"          {Event Time} as string,",
				"          {On Call} as string,",
				"          PT as string,",
				"          RC as string,",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          Room as string,",
				"          {Start Time} as string,",
				"          {End Time} as string,",
				"          {Radiographer 1} as string,",
				"          {Radiographer 2} as string,",
				"          {Required Clinician} as string,",
				"          {Contrast Code} as string,",
				"          {Qty Used} as decimal(6,2),",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          {Status Code} as string,",
				"          {Booked Date} as timestamp,",
				"          {Booked Time} as string,",
				"          {Creation Date} as timestamp,",
				"          Attended as string,",
				"          {Event Key2} as integer,",
				"          {Lead Clinician} as string,",
				"          {Intended Radiologist} as string,",
				"          Urg as string,",
				"          {Referring Locat Name } as string,",
				"          {Referrer Name} as string,",
				"          Modality as string,",
				"          {No of Proc} as integer,",
				"          {GP Name} as string,",
				"          {Planned Appointment Date} as timestamp,",
				"          {Date First Verified} as timestamp,",
				"          {Reported By} as string,",
				"          {Reported By2} as string,",
				"          {Reported By2 Name} as string,",
				"          {Reported By Name} as string,",
				"          {Time First Verified} as string,",
				"          {Time Taken} as integer,",
				"          {Typed By} as string,",
				"          {Was Planned} as string,",
				"          {Was Scheduled} as string,",
				"          {Was Waiting} as string,",
				"          CCG as string,",
				"          Postcode as string,",
				"          {Day of Week} as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'Stat Date',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: (\"select * from dev.FYF_ODBC_Core where [Stat Date] > (SELECT [CoreUpdateValue] FROM [dev].[CoreUpdatetable] where [TableName]='Core')\"),",
				"     format: 'query',",
				"     mode: 'read') ~> AzureSqlCORE",
				"source(output(",
				"          {CRIS No} as integer,",
				"          {Creation Date} as timestamp,",
				"          {Mutation Date} as timestamp,",
				"          DOB as timestamp,",
				"          {Event Date} as timestamp,",
				"          DOD as timestamp,",
				"          {Ethnic Origin} as string,",
				"          GP as string,",
				"          {No of Attends} as integer,",
				"          {No of Events} as integer,",
				"          {Ref Src} as string,",
				"          {Postcode L} as string,",
				"          {Postcode R} as string,",
				"          Gender as string,",
				"          {Referrer Name} as string,",
				"          {Age at Event} as integer,",
				"          {HIS ID} as string,",
				"          CCG as string,",
				"          Postcode as string,",
				"          {Stat Date} as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          {Unique  Identifier for patient} as string,",
				"          {Ref Src} as string,",
				"          {Referring Locat} as string,",
				"          Referrer as string,",
				"          Speciality as string,",
				"          GP as string,",
				"          Practice as string,",
				"          Site as string,",
				"          {Request Date} as string,",
				"          {Event Date/Time} as string,",
				"          PT as string,",
				"          RC as string,",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          Room as string,",
				"          {Exam Start Date/Time} as string,",
				"          {Exam End Date/Time} as string,",
				"          {Radiographer 1} as string,",
				"          {Radiographer 2} as string,",
				"          {Qty Used} as string,",
				"          {Exam Key} as string,",
				"          {Event Key} as string,",
				"          {Status Code} as string,",
				"          {Booked Date/Time} as string,",
				"          Attended as string,",
				"          {Lead Clinician} as string,",
				"          Urg as string,",
				"          {Referring Locat Name} as string,",
				"          {Referrer Name} as string,",
				"          Modality as string,",
				"          {No of Proc} as string,",
				"          {GP Name} as string,",
				"          {Date/Time First Verified} as string,",
				"          {Reported By} as string,",
				"          {Reported By2} as string,",
				"          {Reported By Name} as string,",
				"          {Reported By2 Name} as string,",
				"          {Time Taken} as string,",
				"          {Was Planned} as string,",
				"          {Was Waiting} as string,",
				"          CCG as string,",
				"          {Stat Date} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"union1 window(over({Exam Key}),",
				"     desc({Stat Date}, false),",
				"     Rank = denseRank()) ~> window1",
				"filter2, source1 lookup(union1@{CRIS No} == source1@{CRIS No}",
				"     && union1@{Event Date} == source1@{Event Date},",
				"     multiple: true,",
				"     broadcast: 'auto')~> lookup1",
				"window1 filter(Rank==1) ~> filter2",
				"AzureSqlCORE, derivedColumn1 union(byName: true)~> union1",
				"source2 select(mapColumn(",
				"          Accession = {Unique  Identifier for patient},",
				"          {Ref Src},",
				"          {Referring Locat},",
				"          Referrer,",
				"          Speciality,",
				"          GP,",
				"          Practice,",
				"          Site,",
				"          {Request Date},",
				"          {Event Date} = {Event Date/Time},",
				"          {Event Time} = {Event Date/Time},",
				"          PT,",
				"          RC,",
				"          Examination,",
				"          {Exam Name},",
				"          Room,",
				"          {Start Time} = {Exam Start Date/Time},",
				"          {End Time} = {Exam End Date/Time},",
				"          {Radiographer 1},",
				"          {Radiographer 2},",
				"          {Qty Used},",
				"          {Exam Key},",
				"          {Event Key},",
				"          {Status Code},",
				"          {Booked Date} = {Booked Date/Time},",
				"          {Booked Time} = {Booked Date/Time},",
				"          Attended,",
				"          {Lead Clinician},",
				"          Urg,",
				"          {Referring Locat Name},",
				"          {Referrer Name},",
				"          Modality,",
				"          {No of Proc},",
				"          {GP Name},",
				"          {Date First Verified} = {Date/Time First Verified},",
				"          {Reported By},",
				"          {Reported By2},",
				"          {Reported By Name},",
				"          {Reported By2 Name},",
				"          {Time Taken},",
				"          {Was Planned},",
				"          {Was Waiting},",
				"          CCG,",
				"          {Stat Date}",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive({Stat Date} = toTimestamp({Stat Date}),",
				"          {Time Taken} = toLong({Time Taken}),",
				"          {Date First Verified} = toTimestamp({Date First Verified}),",
				"          {No of Proc} = toLong({No of Proc}),",
				"          {Booked Date} = toTimestamp({Booked Date}),",
				"          {Event Date} = toTimestamp({Event Date}),",
				"          {Request Date} = toTimestamp({Request Date}),",
				"          {Exam Key} = toLong({Exam Key}),",
				"          {Event Key} = toLong({Event Key}),",
				"          {Qty Used} = toDecimal({Qty Used})) ~> derivedColumn1",
				"lookup1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
				"          {Ref Src} as string,",
				"          Site as string,",
				"          {Request Date} as timestamp,",
				"          {Event Date} as timestamp,",
				"          {Event Time} as string,",
				"          {On Call} as string,",
				"          PT as string,",
				"          Examination as string,",
				"          {Exam Name} as string,",
				"          Room as string,",
				"          {ExamSite Code} as string,",
				"          {Start Time} as string,",
				"          {End Time} as string,",
				"          {Exam Key} as integer,",
				"          {Event Key} as integer,",
				"          {Status Code} as string,",
				"          {Booked Date} as timestamp,",
				"          {Booked Time} as string,",
				"          {Creation Date} as timestamp,",
				"          Attended as string,",
				"          Urg as string,",
				"          Modality as string,",
				"          {No of Proc} as integer,",
				"          {Planned Appointment Date} as timestamp,",
				"          {Date First Verified} as timestamp,",
				"          {Time First Verified} as string,",
				"          {Was Planned} as string,",
				"          {Was Scheduled} as string,",
				"          {Was Waiting} as string,",
				"          {Stat Date} as timestamp,",
				"          Modality2 as string,",
				"          {Trust Name} as string,",
				"          Patient_Type as string,",
				"          {Tat Type} as string,",
				"          {Status Time} as string,",
				"          {Reported By} as string,",
				"          Rank as integer,",
				"          {Age At Event} as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     preSQLs:['Delete T\\nFROM\\n(\\nSELECT *\\n, DupRank = ROW_NUMBER() OVER (\\n              PARTITION BY [Exam Key], [Status Code]\\n              ORDER BY [Stat Date] desc\\n            )\\n  FROM [dev].[FYF_ODBC_CORE]\\n) AS T\\nwhere DupRank>1'],",
				"     postSQLs:['delete T\\nFROM\\n(\\nSELECT *\\n, DupRank = ROW_NUMBER() OVER (\\n              PARTITION BY [Exam Key], [Status Code]\\n              ORDER BY [Stat Date] desc\\n            )\\n  FROM [dev].[AzureSqlCOREStageStep1]\\n) AS T\\nwhere DupRank>1'],",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {CRIS No} = union1@{CRIS No},",
				"          Accession,",
				"          {Ref Src} = union1@{Ref Src},",
				"          Site,",
				"          {Request Date},",
				"          {Event Date} = union1@{Event Date},",
				"          {Event Time},",
				"          {On Call},",
				"          PT,",
				"          Examination,",
				"          {Exam Name},",
				"          Room,",
				"          {Start Time},",
				"          {End Time},",
				"          {Exam Key},",
				"          {Event Key},",
				"          {Status Code},",
				"          {Booked Date},",
				"          {Booked Time},",
				"          {Creation Date} = union1@{Creation Date},",
				"          Attended,",
				"          Urg,",
				"          Modality,",
				"          {No of Proc},",
				"          {Planned Appointment Date},",
				"          {Date First Verified},",
				"          {Time First Verified},",
				"          {Was Planned},",
				"          {Was Scheduled},",
				"          {Was Waiting},",
				"          {Stat Date} = union1@{Stat Date},",
				"          {Reported By},",
				"          Rank,",
				"          {Age At Event} = {Age at Event}",
				"     )) ~> AzureSqlCOREStageStep1"
			]
		}
	}
}