				"          {Exam ID},",
				"          {Exam Room ID},",
				"          {Trust ID},",
				"          {Referral Source ID},",
				"          {Tat Type ID},",
				"          {Reported By},",
				"          Rank,",
				"          {Requested Date},",
				"          {Referral Source} = {RemoveColumns2@Referral Source},",
				"          {Request Date},",
				"          Activity,",
				"          {ActivIty 1},",
				"          {Data Pull Date},",
				"          {Age At Event},",
				"          {Event Time},",
				"          {Event Date},",
				"          {Req-Image-Days},",
