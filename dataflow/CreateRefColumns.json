				"          {ExamSite Code}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select7",
				"select7 window(over({Exam Key}),",
				"     desc({Stat Date}, true),",
				"     Rank = denseRank()) ~> window1",
				"window1 filter(Rank==1) ~> filter1",
				"MainStream, source1 join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'undefined',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> Main",
				"Main sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {CRIS No} as integer,",
				"          Accession as string,",
