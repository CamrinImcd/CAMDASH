				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupTatType",
				"MapDrifted2 select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumn2",
