				"          {Exam End Time},",
				"          {Exam Key},",
				"          {Event Key},",
				"          {Status Code} = {select9@Status Code},",
				"          {Booked Date},",
				"          {Booked Time},",
				"          {Creation Date},",
				"          {Exam Attended},",
				"          {Exam Urgency},",
				"          Modality,",
				"          {Number of Processes},",
				"          {Planned Appointment Date},",
				"          {Date First Verified},",
				"          {Time First Verified},",
				"          {Was Planned},",
				"          {Was Scheduled},",
				"          {Was Waiting},",
				"          {Data Pull Date},",
				"          {Reported By},",
				"          {Age At Event},",
				"          {Requested Date},",
				"          {Requested Time},",
				"          Modality2 = {select9@Modality2},",
				"          {Trust Name},",
				"          Patient_Type = {select9@Patient_Type},",
				"          {Tat Type},",
				"          Activity,",
				"          {ActivIty 1},",
				"          {ExamSite Code},",
				"          Rank,",
