				"          {Exam Room ID} = toLong(byName('Exam Room ID')),",
				"          Description = toString(byName('Description'))) ~> MapDrifted6",
				"AzureSQLCoreV2Staging select(mapColumn(",
				"          {CRIS No},",
				"          Accession,",
