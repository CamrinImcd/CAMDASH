				"          {Exam Name} = RemoveColumns2@{Exam Name},",
				"          {Status Code},",
				"          Modality2,",
				"          {Trust Name} = RemoveColumns2@{Trust Name},",
				"          Patient_Type,",
				"          {Tat Type} = RemoveColumns2@{Tat Type},",
				"          {Exam Site} = {MapDrifted6@Exam Site},",
				"          {Status Category},",
				"          {Exam Name} = Exam@{Exam Name},",
				"          {Exam Code} = {Exam@Exam Code},",
				"          {ExamSite Code} = RenameColumn2@{ExamSite Code},",
				"          {Exam Room} = {MapDrifted6@Exam Room},",
				"          Description,",
				"          {Trust Name} = Trust@{Trust Name},",
				"          {Trust Name Group},",
				"          {Trust Name Group2},",
				"          {Trust Name Group3},",
				"          {Referral Source} = {ReferralSource@Referral Source},",
				"          {Tat Type} = TatType@{Tat Type},",
				"          Target",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> MainStream",
				"PatientType derive({Patient Type ID} = toLong(byName('Patient Type ID'))) ~> MapDrifted3",
				"lookupTatType select(mapColumn(",
				"          {CRIS No},",
				"          Accession,",
				"          {Referral Source},",
				"          {Exam Site},",
				"          {Request Date},",
				"          {Event Date},",
