				"          {Status Category}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumns2",
				"filter1 derive({Requested Time} = toTimestamp(concat(toString({Request Date}),' ',substring(lpad(toString({Status Time}),4,\"0\"), 0,2),':',substring(lpad(toString({Status Time}),4,\"0\"), 2,2),':','00')),",
				"          {Request Date} = toTimestamp({Request Date}),",
				"          {Event Time} = toTimestamp(concat(toString({Event Date}),' ',substring({Event Time}, 0,2),':',substring({Event Time}, 2,2),':','00')),",
				"          {Event Date} = toTimestamp({Event Date}),",
				"          {Start Time} = toTimestamp({Start Time},'HH:mm:ss'),",
				"          {End Time} = toTimestamp({End Time},'HH:mm:ss'),",
				"          {Booked Time} = toTimestamp(concat(toString({Booked Date}),' ',substring({Booked Time}, 0,2),':',substring({Booked Time}, 2,2),':','00')),",
				"          {Creation Date} = toDate({Creation Date}),",
				"          {Planned Appointment Date} = toDate({Planned Appointment Date}),",
				"          {Time First Verified} = toTimestamp(concat(toString({Date First Verified}),' ',substring({Time First Verified}, 0,2),':',substring({Time First Verified}, 2,2),':','00'))) ~> DerivedColumn1",
				"MapDrifted3 select(mapColumn(",
				"          Patient_Type,",
				"          {Patient Type ID}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumn",
				"lookupStatus, RenameColumn lookup(select7@Patient_Type == RenameColumn@Patient_Type,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupPatientType",
				"LookupPatientType, Modality lookup(RemoveColumns1@Modality2 == Modality@Modality2,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupModality",
				"DerivedColumn1, Status lookup(RemoveColumns1@{Status Code} == Status@{Status Code},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupStatus",
				"lookupModality, Exam lookup(Examination == Exam@{Exam Code},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupExam",
				"lookupExam, MapDrifted6 lookup(RemoveColumns3@{ExamSite Code} == RenameColumn2@{ExamSite Code},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupExamSite",
				"lookupExamSite, Trust lookup(RemoveColumns4@{Trust Name} == Trust@{Trust Name},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup6",
				"lookup6, ReferralSource lookup({Ref Src} == ReferralSource@{Referral Source},",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupReferralSource",
